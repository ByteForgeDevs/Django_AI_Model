# Committed template. The real .env is not in the repository, which is the
# whole point of the twelve-factor shape -- and the reason a reader cannot tell
# from the source what any of these settings will be at runtime.
DJANGO_DEBUG=off
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=app.example.test
DATABASE_URL=postgres://user:password@db.example.test:5432/app
EMAIL_HOST_PASSWORD=
