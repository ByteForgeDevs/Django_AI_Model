.github
.venv
venv
benchmarks
docs
tests
scripts
schema
*.egg-info
build
dist
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
*.sarif
*.log
.pre-commit-hooks.yaml
action.yml
CHANGELOG.md
Dockerfile
